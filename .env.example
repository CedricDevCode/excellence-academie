# =============================================
# Excellence Académie — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# =============================================

# ── Base de données PostgreSQL ─────────────────
# Format Hostinger: postgresql://USER:PASS@HOST:5432/DB_NAME?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ── Serveur ────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── URL du frontend (votre domaine Hostinger) ──
FRONTEND_URL=https://votre-domaine.com

# ── CORS (si frontend sur un sous-domaine séparé)
CORS_ORIGINS=https://votre-domaine.com

# ── Email SMTP ─────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@votre-domaine.com
SMTP_PASS=votre-mot-de-passe-email
SMTP_FROM=noreply@votre-domaine.com

# ── Inscription espèces (code OTP) ─────────────
# Destinataire du code de confirmation d'inscription par paiement en espèces.
CASH_OTP_EMAIL=ea@exacademie.com

# ── GeniusPay ──────────────────────────────────
GENIUSPAY_API_KEY=pk_live_VOTRE_CLE
GENIUSPAY_SECRET_KEY=sk_live_VOTRE_SECRET
GENIUSPAY_ENVIRONMENT=production
GENIUSPAY_WEBHOOK_SECRET=votre-webhook-secret
GENIUSPAY_API_BASE=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_SANDBOX=false

# ── Push Notifications (VAPID) ─────────────
# Générer avec: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=YOUR_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_KEY
VAPID_SUBJECT=mailto:contact@exacademie.net

# ── JWT ────────────────────────────────────────
JWT_SECRET=CHANGEZ-CECI-EN-UN-SECRET-ALEATOIRE-LONG-ET-SECURISE

# ── Sécurité Admin ─────────────────────────────
# Mot de passe du compte admin créé au 1er démarrage (si le compte n'existe pas encore).
# ⚠️ OBLIGATOIRE au 1er déploiement. Retirez cette variable après création du compte.
ADMIN_INITIAL_PASSWORD=CHANGEZ-CE-MOT-DE-PASSE-ADMIN

# ── Health Check (optionnel) ───────────────────
# Si défini, /api/health nécessite le header X-Health-Secret pour voir les détails.
# Laissez vide pour un accès minimal sans détails sensibles.
HEALTH_SECRET=

# ── Limites anti-abus (optionnel) ──────────────
# Plusieurs inscriptions/logins peuvent venir d'une même adresse (établissement).
# Valeurs par défaut : 60 inscriptions publiques/h, 300 en espèces/h, 60 paiements/h,
# 1500 requêtes API/15 min. Augmentez si nécessaire.
REGISTER_RATE_MAX=60
CASH_REGISTER_RATE_MAX=300
PAYMENT_INIT_RATE_MAX=60
GLOBAL_RATE_MAX=1500

# ── Analytics (optionnel) ────────────────────────
# Identifiant de mesure GA4. Si absent, aucun script Google n'est chargé.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Déploiement ──────────────────────────────────
# Mettre à 'production' pour activer la redirection HTTPS, le HSTS et le cache HTTPS.
NODE_ENV=production
# URL publique du front (utilisée par les CORS/CSP). Exemple : https://www.exacademie.net
FRONTEND_URL=https://www.exacademie.net
