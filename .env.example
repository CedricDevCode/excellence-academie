# =============================================
# Excellence Académie — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# =============================================

# ── Base de données PostgreSQL ─────────────────
# Format Hostinger: postgresql://USER:PASS@HOST:5432/DB_NAME?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# ── Serveur ────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── URL du frontend (votre domaine Hostinger) ──
FRONTEND_URL=https://votre-domaine.com

# ── CORS (si frontend sur un sous-domaine séparé)
CORS_ORIGINS=https://votre-domaine.com

# ── Email SMTP ─────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@votre-domaine.com
SMTP_PASS=votre-mot-de-passe-email
SMTP_FROM=noreply@votre-domaine.com

# ── GeniusPay ──────────────────────────────────
GENIUSPAY_API_KEY=pk_live_VOTRE_CLE
GENIUSPAY_SECRET_KEY=sk_live_VOTRE_SECRET
GENIUSPAY_ENVIRONMENT=production
GENIUSPAY_WEBHOOK_SECRET=votre-webhook-secret
GENIUSPAY_API_BASE=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_SANDBOX=false

# ── JWT ────────────────────────────────────────
JWT_SECRET=CHANGEZ-CECI-EN-UN-SECRET-ALEATOIRE-LONG-ET-SECURISE
